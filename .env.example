# Copy this file to `.env` and fill in your Supabase project values.
# NEVER commit `.env` (it is already listed in .gitignore).
#
# Where to find these (Supabase Dashboard → Project Settings → API):
#   VITE_SUPABASE_URL      → Project URL
#   VITE_SUPABASE_ANON_KEY → anon / public key (safe to expose in the browser;
#                             Row Level Security policies protect user data)
#
# Do NOT put the `service_role` key here — it bypasses RLS and must only
# ever live on a trusted server, never in frontend code.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
